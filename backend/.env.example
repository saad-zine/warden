# Warden backend configuration — copy to backend/.env and edit.
# Every value below is optional: with no .env at all, Warden runs fully
# offline on the deterministic model and (fallback-capable) web tools.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# auto          prefer OPENAI_API_KEY, then ANTHROPIC_API_KEY, then a
#               reachable Ollama, then the offline deterministic model
# openai        requires OPENAI_API_KEY
# anthropic     requires ANTHROPIC_API_KEY
# ollama        requires a running Ollama server (default http://localhost:11434/v1)
# deterministic no network, no key (what the test suite uses)
#
# An explicitly configured provider is never silently replaced: if it fails,
# the run fails with failure_reason="model_error" instead of faking success
# on the offline model.
WARDEN_LLM=auto

# Leave empty to use the provider default:
#   openai -> gpt-4.1-mini · anthropic -> claude-sonnet-4-20250514 · ollama -> qwen3:4b
WARDEN_LLM_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible gateway (vLLM, Groq, OpenRouter, LM Studio, ...).
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Used when WARDEN_LLM=ollama, and by `auto` to detect a running server.
OLLAMA_BASE_URL=http://localhost:11434/v1

WARDEN_LLM_TEMPERATURE=0
WARDEN_LLM_TIMEOUT=90
WARDEN_LLM_RETRIES=2

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
# auto   real network tools, with a labelled mock fallback when the network
#        is unavailable (the trace says `mock (fallback: ...)`, never silently)
# real   real tools only; failures surface as tool errors
# mock   fully offline synthetic data (deterministic; used by the tests)
WARDEN_TOOLS=auto

# Search provider chain: Tavily -> Brave -> DuckDuckGo HTML (no key needed).
TAVILY_API_KEY=
BRAVE_API_KEY=

WARDEN_WEB_TIMEOUT=8
WARDEN_WEB_MAX_BYTES=1000000
WARDEN_WEB_MAX_REDIRECTS=3

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# Runs execute in a bounded background pool; the API returns 202 immediately
# and the UI follows via SSE. Raise this only if your provider allows it.
WARDEN_WORKERS=4

# How often the SSE endpoint checks for new trace rows (seconds).
WARDEN_STREAM_POLL=0.2

# Per-run guardrails (USD estimate / token proxy / tool-call iterations).
WARDEN_MAX_COST_USD=0.50
WARDEN_MAX_TOKENS=20000
WARDEN_MAX_ITERATIONS=12

# ---------------------------------------------------------------------------
# Storage & serving
# ---------------------------------------------------------------------------
# WARDEN_DATA_DB=./warden.db
# WARDEN_CHECKPOINT_DB=./checkpoints.db

# Comma-separated origins, or * for local development.
# There is no auth yet: do not expose this publicly.
WARDEN_CORS_ORIGINS=*
